grammar com.google.eclipse.protobuf.Protobuf hidden(WS, ML_COMMENT, SL_COMMENT)

import "http://www.eclipse.org/emf/2002/Ecore" as ecore
generate protobuf "http://www.google.com/eclipse/protobuf/Protobuf"

Protobuf:
  {Protobuf}
  ((syntax=Syntax | edition=Edition)
    (elements+=ProtobufElement | misplacedHeaders+=MisplacedHeader | ';')*
  | (elements+=ProtobufElement | ';')
    (elements+=ProtobufElement | misplacedHeaders+=MisplacedHeader | ';')*)?;

Syntax:
  'syntax' '=' name=StringLiteral ';';

Edition:
  {Edition} 'edition' '=' name=StringLiteral ';';

// Preserve declarations after an invalid header without making that header effective.
// RecoveringProtobufParser marks these nodes as syntax errors.
MisplacedHeader:
  {MisplacedHeader} ('syntax' | isEdition?='edition') '=' name=StringLiteral ';';

ProtobufElement:
  Package | Import | Option | ComplexType | TypeExtension | Service;

Package:
  'package' importedNamespace=PackageName ';';

PackageName:
  IdOrReservedWord ('.' IdOrReservedWord)*;

Import:
  NormalImport | PublicImport | WeakImport | OptionImport;

NormalImport:
  'import' path=StringLiteral ';';

PublicImport:
  'import' 'public' path=StringLiteral ';';

WeakImport:
  'import' 'weak' path=StringLiteral ';';

OptionImport:
  'import' 'option' path=StringLiteral ';';

ComplexType:
  Enum | ExtensibleType;

Message:
  (visibility=Visibility)? ->'message' name=Name '{'
  (elements+=MessageElement | ';')*
  '}' (';')?;

MessageElement:
  ->Option | Extensions | ComplexType | TypeExtension | OneOf | Reserved | MessageField;

IndexRange:
  from=IndexNumber ('to' to=IndexRangeMax)?;

IndexRangeMax:
  IndexNumber | 'max';

// Hack to make the default modifier 'unspecified'
enum ModifierEnum:
  unspecified | optional | required | repeated
;

enum Modifier returns ModifierEnum:
  optional | required | repeated;

// Keep unspecified as the default while accepting only source visibility modifiers.
enum SymbolVisibilityEnum:
  unspecified | export | local;

enum Visibility returns SymbolVisibilityEnum:
  export | local;

// Recovery-only omissions in field/group rules are diagnosed by RecoveringProtobufParser.

Group:
  (modifier=Modifier)? =>'group' name=Name ('=' index=IndexNumber)?
  (->'[' (fieldOptions+=FieldOption (',' fieldOptions+=FieldOption)*) ']')? '{'
  (elements+=GroupElement | ';')*
  '}' (';')?;

GroupElement:
  ->Option | ComplexType | TypeExtension | Extensions | Reserved | MessageField;

OneOf:
  (isRepeated?='repeated')? =>'oneof' name=Name '{'
  elements+=OneOfElement*
  '}' (';')?;

OneOfElement returns MessageElement:
  Option | Extensions | Group | MessageField;

Extensions:
  ->'extensions' ranges+=IndexRange (',' ranges+=IndexRange)*
  ('[' fieldOptions+=FieldOption (',' fieldOptions+=FieldOption)* ']')? ';';

MessageField:
  (=>(modifier=Modifier type=TypeLink name=Name) | =>type=TypeLink name=Name) ('=' index=IndexNumber)?
  (->'[' (fieldOptions+=FieldOption (',' fieldOptions+=FieldOption)*)? ']')? ';'?;

TypeLink:
  =>ScalarTypeLink | =>MapTypeLink | ComplexTypeLink;

ScalarTypeLink:
  target=ScalarType;

enum ScalarType:
  double | float | int32 | int64 | uint32 | uint64 | sint32 | sint64 | fixed32 | fixed64 | sfixed32 | sfixed64 | bool |
  string | bytes;

ComplexTypeLink:
  target=[ComplexType|QualifiedName];

MapTypeLink:
  target=MapType;

MapType:
  ->'map' '<' keyType=TypeLink ',' valueType=TypeLink '>';

Enum:
  (visibility=Visibility)? ->'enum' name=Name '{'
  (elements+=EnumElement | ';')*
  '}' ';'?;

EnumElement:
  Option | Literal | ReservedEnum;

Literal:
  name=Name '=' index=IndexNumber
  ('[' fieldOptions+=FieldOption (',' fieldOptions+=FieldOption)* ']')? ';';

IndexNumber returns ecore::ELong:
  '-'? (LONG | HEX);

SignedLong returns ecore::EBigInteger:
  '-'? LONG;

SignedHex returns ecore::EBigInteger:
  '-'? HEX;

FloatingPointValue returns ecore::EDouble:
  '-'? DOUBLE;

terminal HEX:
  '0' ('x' | 'X') (DIGIT | 'a'..'f' | 'A'..'F')+;

TypeExtension:
  ->'extend' type=ExtensibleTypeLink '{'
  elements+=IndexedElement*
  '}' (';')?;

ExtensibleTypeLink:
  target=[ExtensibleType|QualifiedName];

ExtensibleType:
  Message | Group;

Reserved:
  'reserved' reservations+=Reservation (',' reservations+=Reservation)* ';';

// quick hack so that reservations of enums embedded in messages does not interfere
ReservedEnum:
  'reserved' reservations+=Reservation (',' reservations+=Reservation)* ';';

Reservation:
  IndexRange | StringLiteral | ReservedName;

ReservedName:
  name=Name;

Service:
  ->'service' name=Name '{'
  (elements+=ServiceElement | ';')*
  '}' (';')?;

ServiceElement:
  Option | Rpc | Stream;

Rpc:
  ->'rpc' name=Name '(' (=>isArgStreaming?='stream')? argType=MessageLink ')'
  'returns' '(' (=>isReturnStreaming?='stream')? returnType=MessageLink ')'
  (('{' (options+=Option | ';')* '}') (';')? | ';');

Stream:
  ->'stream' name=Name '(' clientMessage=MessageLink ',' serverMessage=MessageLink ')'
  (('{' (options+=Option | ';')* '}') (';')? | ';');

Name:
  IdOrReservedWord;

IdOrReservedWord:
  ID | ReservedWord;

MessageLink:
  target=[Message|QualifiedName];

AbstractOption:
  Option | FieldOption;

AbstractCustomOption:
  CustomOption | CustomFieldOption;

Option:
  'option' (NativeOption | CustomOption);

NativeOption:
  source=NativeOptionSource
  ('.' fields+=OptionField ('.' fields+=OptionField)*)? '=' value=Value? ';';

CustomOption:
  '(' source=OptionSource ')'
  ('.' fields+=OptionField ('.' fields+=OptionField)*)? '=' value=Value? ';';

FieldOption:
  DefaultValueFieldOption | JsonNameFieldOption | NativeFieldOption | CustomFieldOption;

DefaultValueFieldOption:
  =>'default' '=' value=Value?;

JsonNameFieldOption:
  =>'json_name' '=' value=Value?;

NativeFieldOption:
  source=NativeOptionSource ('.' fields+=OptionField ('.' fields+=OptionField)*)? '=' value=Value?;

CustomFieldOption:
  ->'(' source=OptionSource ')'
  ('.' fields+=OptionField ('.' fields+=OptionField)*)? '=' value=Value?;

OptionSource:
  target=[IndexedElement|QualifiedName];

NativeOptionSource returns OptionSource:
  target=[IndexedElement|Name];

OptionField:
  MessageOptionField | '(' ExtensionOptionField ')';

MessageOptionField:
  target=[IndexedElement|Name];

ExtensionOptionField:
  target=[IndexedElement|QualifiedName];

IndexedElement:
  Group | MessageField;

Value:
  ComplexValue | SimpleValueLink;

ComplexValue:
  ComplexValueCurlyBracket | ComplexValueAngleBracket;

// { foo: 1, bar: 2 }
ComplexValueCurlyBracket:
  '{' {ComplexValueCurlyBracket} (fields+=ValueField (',' | ';')?)* '}';

// < foo: 1, bar: 2 >
ComplexValueAngleBracket:
  '<' {ComplexValueAngleBracket} (fields+=ValueField (',' | ';')?)* '>';

ValueField:
  ->SimpleValueField | ComplexValueField;

SimpleValueField:
  name=FieldName (hasColon?=':')?
  (values+=SimpleValueLink | isList?='[' (values+=SimpleValueLink (',' values+=SimpleValueLink)* ','?)? ']');

ComplexValueField:
  name=FieldName (hasColon?=':')?
  (values+=ComplexValue | isList?='[' values+=ComplexValue (',' values+=ComplexValue)* ','? ']');

FieldName:
  NormalFieldName | AnyFieldName | ExtensionFieldName;

NormalFieldName:
  target=[IndexedElement|Name];

ExtensionFieldName:
  '[' target=[IndexedElement|QualifiedName] ']';

AnyFieldName:
  =>('[' urlPrefix=AnyUrlPrefix) embeddedType=[Message|QualifiedName] ']';

AnyUrlPrefix:
  AnyUrlSegment '/' (=>AnyUrlPath)*;

AnyUrlPath:
  AnyUrlSegment '/';

AnyUrlSegment:
  (IdOrReservedWord | LONG | HEX | DOUBLE | '.' | '-' | '~' | '!' | '$' | '&' |
    '(' | ')' | '*' | '+' | ',' | ';' | '=' | PERCENT_ENCODED)+;

terminal PERCENT_ENCODED:
  '%' (DIGIT | 'a'..'f' | 'A'..'F') (DIGIT | 'a'..'f' | 'A'..'F');

QualifiedName:
  '.'? SafeId ('.' (WS)* SafeId)*;

SafeId:
  ID | SafeReservedWord;

ReservedWord:
  SafeReservedWord | 'group' | 'oneof';

// These tokens appear as keywords in other rules. Explicitly listing them here prevents the lexer
// from consuming them as keywords and gives the parser a chance to interpret them as identifiers.
SafeReservedWord:
  'bool' |
  'bytes' |
  'default' |
  'double' |
  'edition' |
  'enum' |
  'export' |
  'extend' |
  'extensions' |
  'false' |
  'fixed32' |
  'fixed64' |
  'float' |
  'import' |
  'inf' |
  'int32' |
  'int64' |
  'json_name' |
  'local' |
  'map' |
  'max' |
  'message' |
  'nan' |
  'option' |
  'optional' |
  'package' |
  'public' |
  'repeated' |
  'required' |
  'reserved' |
  'returns' |
  'rpc' |
  'service' |
  'sfixed32' |
  'sfixed64' |
  'sint32' |
  'sint64' |
  'stream' |
  'string' |
  'syntax' |
  'to' |
  'true' |
  'uint32' |
  'uint64' |
  'weak';

SimpleValueLink:
  LiteralLink | NumberLink | StringLink;

LiteralLink:
  (isNegative?='-')? target=[Literal|Name];

NumberLink:
  HexNumberLink | =>LongLink | DoubleLink;

HexNumberLink:
  target=SignedHex;

LongLink:
  target=SignedLong;

terminal LONG:
  DIGIT+;

DoubleLink:
  target=FloatingPointValue;

terminal DOUBLE:
  ((DIGIT+ '.' DIGIT* | '.' DIGIT+) (('e' | 'E') ('-' | '+')? DIGIT+)? |
    DIGIT+ ('e' | 'E') ('-' | '+')? DIGIT+) ('f' | 'F')? |
  DIGIT+ ('f' | 'F');

terminal fragment DIGIT:
  '0'..'9';

StringLink:
  target=StringLiteral;

StringLiteral:
  chunks+=CHUNK+;

terminal CHUNK:
  '"' ('\\' !('\u0000' | '\n' | '\r') | !('\\' | '"' | '\u0000' | '\n' | '\r'))* '"' |
  "'" ('\\' !('\u0000' | '\n' | '\r') | !('\\' | "'" | '\u0000' | '\n' | '\r'))* "'";

terminal ID: '^'?('a'..'z'|'A'..'Z'|'_') ('a'..'z'|'A'..'Z'|'_'|DIGIT)*;
terminal ML_COMMENT: '/*' -> '*/';
terminal SL_COMMENT: '//' !('\n'|'\r')* ('\r'? '\n')?;
terminal WS: (' '|'\t'|'\r'|'\n')+;
terminal ANY_OTHER: .;
