<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<?pde version="3.8"?>
<target name="Protocol Buffer Editor Target Platform">
	<locations>
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://eclipse-nexus.dinf.gebit.dev/content/groups/eclipse-2025-03-all/"/>
			<unit id="org.eclipse.platform.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.sdk.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.jdt.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.pde.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.cdt.feature.group" version="0.0.0"/>
			<!-- required by org.eclipse.cdt.core, not pulled in transitively by the cdt feature. -->
			<unit id="org.eclipse.launchbar.core" version="0.0.0"/>
			<!-- transitively required via org.eclipse.cdt.ui -> org.eclipse.search. -->
			<unit id="org.eclipse.search.core" version="0.0.0"/>
			<!-- transitively required via org.eclipse.cdt.ui. -->
			<unit id="org.eclipse.tools.templates.core" version="0.0.0"/>
			<unit id="org.eclipse.tools.templates.freemarker" version="0.0.0"/>
			<unit id="org.eclipse.tools.templates.ui" version="0.0.0"/>
			<!-- provides the EventAdmin implementation the e4/workbench IEventBroker relies
			     on at test runtime; no longer pulled in automatically by tycho-surefire. -->
			<unit id="org.eclipse.equinox.event" version="0.0.0"/>
			<unit id="org.eclipse.xtext.sdk.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.emf.feature.group" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe.core" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe.utils" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe2.launch" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe2.language" version="0.0.0"/>
			<unit id="org.eclipse.emf.mwe2.runtime" version="0.0.0"/>
			<unit id="org.aopalliance" version="0.0.0"/>
			<unit id="org.apache.commons.cli" version="0.0.0"/>
			<unit id="org.apache.commons.commons-io" version="0.0.0"/>
			<unit id="org.apache.batik.i18n" version="0.0.0"/>
			<unit id="org.apache.batik.util" version="0.0.0"/>
			<unit id="org.apache.batik.constants" version="0.0.0"/>
			<unit id="org.apache.batik.css" version="0.0.0"/>
			<unit id="org.apache.xmlgraphics" version="0.0.0"/>
			<unit id="bcprov" version="0.0.0"/>
			<unit id="bcpg" version="0.0.0"/>
			<unit id="bcutil" version="0.0.0"/>
			<unit id="org.tukaani.xz" version="0.0.0"/>
			<unit id="io.github.classgraph.classgraph" version="0.0.0"/>
			<unit id="org.eclipse.orbit.xml-apis-ext" version="0.0.0"/>
			<unit id="com.google.guava" version="0.0.0"/>
			<!-- split off from com.google.guava, required by com.google.guava's ListenableFuture support; not pulled in transitively by the slicer. -->
			<unit id="com.google.guava.failureaccess" version="0.0.0"/>
			<unit id="com.google.inject" version="0.0.0"/>
			<unit id="com.ibm.icu" version="0.0.0"/>
			<!-- both 1.3.5 (exports legacy "javax.annotation", needed by m2e) and 2.1.1
			     (exports "jakarta.annotation", needed by org.eclipse.ui.ide/workbench) are
			     required simultaneously since they export different packages. -->
			<unit id="jakarta.annotation-api" version="1.3.5"/>
			<unit id="jakarta.annotation-api" version="2.1.1"/>
			<unit id="jakarta.inject.jakarta.inject-api" version="2.0.1"/>
			<!-- 1.0.5 still exports the legacy "javax.inject" package (2.0.1 renamed the
			     package to "jakarta.inject"); m2e's Import-Package: javax.inject needs this. -->
			<unit id="jakarta.inject.jakarta.inject-api" version="1.0.5"/>
			<unit id="org.objectweb.asm" version="0.0.0"/>
			<!-- required by org.apache.aries.spifly.dynamic.bundle, a transitive dependency of m2e; not pulled in transitively by the slicer. -->
			<unit id="org.objectweb.asm.commons" version="0.0.0"/>
			<unit id="org.objectweb.asm.tree" version="0.0.0"/>
			<unit id="org.objectweb.asm.tree.analysis" version="0.0.0"/>
			<unit id="org.objectweb.asm.util" version="0.0.0"/>
			<unit id="org.eclipse.xtext.xtext.generator" version="0.0.0"/>
			<unit id="org.eclipse.e4.core.services" version="0.0.0"/>
			<unit id="org.eclipse.e4.core.commands" version="0.0.0"/>
			<unit id="org.eclipse.e4.ui.services" version="0.0.0"/>
			<unit id="org.eclipse.e4.ui.workbench" version="0.0.0"/>
			<!-- required by org.eclipse.cdt.ui; not pulled in transitively by the slicer. -->
			<unit id="org.eclipse.e4.core.contexts" version="0.0.0"/>
			<unit id="org.eclipse.e4.ui.css.swt.theme" version="0.0.0"/>
			<unit id="org.apache.felix.scr" version="2.2.12"/>
			<!-- org.apache.felix.scr's own (non-optional) Import-Package requirements; not
			     pulled in transitively by the slicer since nothing Require-Bundles them by name. -->
			<unit id="org.osgi.service.component" version="0.0.0"/>
			<unit id="org.osgi.util.promise" version="0.0.0"/>
			<unit id="org.eclipse.ui" version="0.0.0"/>
			<unit id="org.eclipse.ui.workbench" version="0.0.0"/>
			<unit id="org.eclipse.ui.ide" version="0.0.0"/>
			<unit id="org.eclipse.ui.editors" version="0.0.0"/>
		</location>

		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://eclipse-nexus.dinf.gebit.dev/content/repositories/eclipse-2025-03/"/>
			<unit id="org.apache.felix.scr" version="2.2.12"/>
			<!-- provides the "osgi.serviceloader.processor" extender required by slf4j.api 2.x
			     (see the orbit location below) -->
			<unit id="org.apache.aries.spifly.dynamic.bundle" version="0.0.0"/>
		</location>

		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://eclipse-nexus.dinf.gebit.dev/content/repositories/eclipse-orbit-2025-03/"/>
			<unit id="org.apache.felix.scr" version="2.2.12"/>
			<unit id="org.antlr.runtime" version="0.0.0"/>
			<unit id="org.apache.commons.logging" version="0.0.0"/>
			<unit id="org.apache.log4j" version="0.0.0"/>
			<unit id="org.mockito.mockito-core" version="0.0.0"/>
			<!-- mockito-core 5.x requires net.bytebuddy, no longer transitively resolved -->
			<unit id="net.bytebuddy.byte-buddy" version="0.0.0"/>
			<unit id="net.bytebuddy.byte-buddy-agent" version="0.0.0"/>
			<unit id="org.objenesis" version="0.0.0"/>
			<unit id="org.junit" version="0.0.0"/>
			<unit id="org.hamcrest" version="0.0.0"/>
			<unit id="org.hamcrest.core" version="0.0.0"/>
			<unit id="org.hamcrest.library" version="0.0.0"/>
			<unit id="com.sun.jna" version="0.0.0"/>
			<unit id="com.sun.jna.platform" version="0.0.0"/>
			<!-- needed by org.eclipse.m2e.core/org.eclipse.m2e.maven.runtime (see the m2e
			     location below); explicit because nothing else in this target platform pulls
			     in a version new enough to satisfy their Import-Package ranges. -->
			<unit id="com.google.gson" version="0.0.0"/>
			<!-- slf4j 2.x (not the older org.slf4j.api 1.7.30 also present in this repo under
			     the legacy unit id); requires org.apache.aries.spifly.dynamic.bundle (added
			     above) to satisfy its "osgi.serviceloader.processor" extender requirement,
			     plus a bundle registered as an actual org.slf4j.spi.SLF4JServiceProvider via
			     the OSGi Service Loader Mediator (slf4j.nop below, since none of our code
			     wants slf4j's own logging output - m2e/Maven route their own log output
			     through this too). -->
			<unit id="slf4j.api" version="2.0.16"/>
			<unit id="slf4j.nop" version="2.0.16"/>
			<!-- m2e also needs org.apache.commons.codec.digest and javax.annotation, but
			     nothing else in this target platform pulls in units new/old enough that
			     export those packages, so pin them explicitly too. -->
			<unit id="org.apache.commons.commons-codec" version="0.0.0"/>
			<!-- needed by org.eclipse.cdt.core (Import-Package: org.osgi.service.component.annotations). -->
			<unit id="org.osgi.service.component.annotations" version="0.0.0"/>
		</location>

		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/technology/swtbot/releases/2.5.0/"/>
			<unit id="org.eclipse.swtbot.go" version="0.0.0"/>
			<!-- org.eclipse.swtbot.go Require-Bundle's all of these (with visibility:=reexport
			     for most), but the target platform resolver doesn't pull in transitive
			     Require-Bundle dependencies of a directly-selected unit, so list them explicitly. -->
			<unit id="org.eclipse.swtbot.eclipse.core" version="0.0.0"/>
			<unit id="org.eclipse.swtbot.eclipse.finder" version="0.0.0"/>
			<unit id="org.eclipse.swtbot.swt.finder" version="0.0.0"/>
			<unit id="org.eclipse.swtbot.junit4_x" version="0.0.0"/>
		</location>

		<!-- not mirrored on GEBIT's Nexus at a version compatible with Eclipse 2025-03
		     (only very old 1.8.4/1.9.1/1.13.0 releases are available there); fetched directly
		     from eclipse.org instead, same as the SWTBot location above. -->
		<location includeAllPlatforms="false" includeConfigurePhase="true" includeMode="slicer" includeSource="false" type="InstallableUnit">
			<repository location="https://download.eclipse.org/technology/m2e/releases/latest/"/>
			<unit id="org.eclipse.m2e.core" version="0.0.0"/>
			<unit id="org.eclipse.m2e.maven.runtime" version="0.0.0"/>
			<!-- optionally required by org.eclipse.m2e.core (Require-Bundle, not optional). -->
			<unit id="org.eclipse.m2e.workspace.cli" version="0.0.0"/>
		</location>
	</locations>
	<targetJRE path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-21"/>
</target>
